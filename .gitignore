# ── Secrets ──────────────────────────────────────────────────────────────────
.env
*.pem
*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.log

# ── ML Artifacts (large binary files) ────────────────────────────────────────
backend/ml_models/
*.joblib
*.pkl
*.h5

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ── Docker ────────────────────────────────────────────────────────────────────
# (keep docker-compose.yml and Dockerfiles, ignore runtime data)

# ── Database / Redis volumes (never committed) ────────────────────────────────
*.db
*.sqlite3

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations/versions/*.py but ignore runtime files
migrations/__pycache__/

# ── Test / Coverage ───────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
