APP_NAME="SEO Intelligence Engine"
ENVIRONMENT=development

# Database & Redis (Internal Docker Network)
POSTGRES_USER=seo_admin
POSTGRES_PASSWORD=StrongLocalPassword123!
POSTGRES_DB=seo_intelligence
DATABASE_URL=postgresql+psycopg2://seo_admin:StrongLocalPassword123!@postgres:5432/seo_intelligence
REDIS_URL=redis://redis:6379/0

# Conservative Crawler Limits for 16 GB RAM
CRAWLER_CONCURRENCY=4
CRAWLER_DOWNLOAD_DELAY=1.5
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_JOB=10000
CRAWLER_MAX_RESPONSE_BYTES=5242880
CELERY_WORKER_CONCURRENCY=2

# DeepSeek Official API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Security & CORS
SECRET_KEY=change-this-to-a-random-64-char-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173